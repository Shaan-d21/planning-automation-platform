EPM_BASE_URL=https://your-epm-instance.example.com
EPM_USERNAME=your.username
EPM_PASSWORD=your.password
APPLICATION_NAME=YourPlanningApplication

# Required platform database. URL-encode special characters in credentials.
DATABASE_URL=postgresql+psycopg://epm_automation:change-me@localhost:5432/epm_automation
RUNTIME_DATA_DIR=var

# Optional settings
# auto detects Oracle Cloud hostnames; use cloud or on_premises to override.
EPM_DEPLOYMENT_MODE=auto
EPM_REQUEST_TIMEOUT=30
EPM_VERIFY_SSL=true
LOG_LEVEL=INFO
DEFAULT_METADATA_IMPORT_MODE=job_definition
DEFAULT_POLL_INTERVAL=5
SCHEDULE_POLL_INTERVAL=15
DEFAULT_JOB_TIMEOUT=1800

# Durable execution runtime:
# - embedded: local development; the web process also executes queued work
# - web: production API only; start worker.py as a separate service
EPM_EXECUTION_RUNTIME=embedded
EXECUTION_WORKER_POLL_INTERVAL=2
EXECUTION_LEASE_SECONDS=120

DEFAULT_METADATA_ENGINE=rest
DEFAULT_DATA_ENGINE=rest
DEFAULT_DATA_INTEGRATION_ENGINE=epmautomate
DEFAULT_BUSINESS_RULE_ENGINE=rest
DEFAULT_PIPELINE_ENGINE=rest
DEFAULT_DATA_MAP_ENGINE=rest
DEFAULT_DATA_INTEGRATION_NAME=Test_DataLoad
DEFAULT_PIPELINE_CODE=PIPE01
DEFAULT_DATA_MAP_NAME=Product_Revenue_to_Reporting
MONTHLY_FORECAST_RUN_DATA_MAP=true
MONTHLY_FORECAST_CLEAR_TARGET=false
PLANNING_CYCLE_CATALOG_FILE=config/planning_cycles.json
REPORT_OUTPUT_DIR=reports
REPORT_CATALOG_FILE=config/reports.json
PLANNING_PROCESS_CATALOG_FILE=config/planning_processes.json

# Use a long random value in shared or production web environments.
WEB_SESSION_SECRET=replace-with-a-long-random-secret
# Set to true when the web application itself is served over HTTPS.
WEB_SECURE_COOKIES=false
# React origin used when redirecting retired server-rendered screens.
# Local development: http://127.0.0.1:5173
# Production: the public HTTPS origin serving frontend/dist
WEB_FRONTEND_URL=http://127.0.0.1:5173

# Platform sign-in mode. Oracle Cloud uses OIDC Authorization Code flow.
# Register /auth/oracle/callback as the redirect URI in OCI IAM/IDCS.
IDENTITY_PROVIDER=local
ORACLE_IDENTITY_ISSUER_URL=
ORACLE_IDENTITY_CLIENT_ID=
# Required for a confidential web application; leave empty for a public PKCE client.
ORACLE_IDENTITY_CLIENT_SECRET=
# Production should be the public HTTPS backend callback URL.
ORACLE_IDENTITY_REDIRECT_URI=http://127.0.0.1:8080/auth/oracle/callback

# Optional read-only AI Agent Workspace (Google AI Studio / Gemini)
AGENT_PROVIDER=gemini
AGENT_ORCHESTRATOR=langgraph
AGENT_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
# Used when AGENT_PROVIDER=groq. Recommended production tool-calling model:
# AGENT_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
# Keep each Groq call below free-tier TPM while preserving the latest request.
GROQ_MAX_INPUT_TOKENS=2500
GROQ_MAX_COMPLETION_TOKENS=384
AGENT_MAX_TOOL_ROUNDS=4
AGENT_HISTORY_MESSAGES=20
# Restrict LangGraph checkpoint deserialization to safe built-in types.
LANGGRAPH_STRICT_MSGPACK=true

# Optional automatic source-to-target validation after a Data Map.
# Configure two forms with the same row/column layout and POV.
VALIDATION_SOURCE_FORM=
VALIDATION_TARGET_FORM=
VALIDATION_TOLERANCE=0
DEFAULT_DATA_INTEGRATION_IMPORT_MODE=Replace
DEFAULT_DATA_INTEGRATION_EXPORT_MODE=Merge
PIPELINE_CATALOG_FILE=config/pipelines.json
DATA_INTEGRATION_CATALOG_FILE=config/data_integrations.json

# Optional task completion email notifications
EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_PROVIDER=smtp
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=your.test.account@gmail.com
EMAIL_SMTP_PASSWORD=your-16-character-app-password
EMAIL_FROM=your.test.account@gmail.com
EMAIL_TO=your.recipient@example.com
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_SMTP_TIMEOUT=30

# Required when using any EPM Automate workflow
EPM_AUTOMATE_EXECUTABLE=C:\Program Files\Oracle\EPM Automate\bin\epmautomate.bat
EPM_AUTOMATE_PASSWORD_FILE=C:\Secure\EPMPassword.epw
EPM_AUTOMATE_COMMAND_TIMEOUT=1800
