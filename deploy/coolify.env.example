# Required Oracle connection. This stage release uses REST engines only.
EPM_BASE_URL=https://your-environment.epm.oraclecloud.com
EPM_INTEGRATION_USERNAME=service.account@example.com
EPM_INTEGRATION_PASSWORD=replace-me
# Required on the stage release so Oracle credential sign-in is available on
# the first startup, before any environment metadata has been persisted.
APPLICATION_NAME=ExactPlanningApplicationName
EPM_DEPLOYMENT_MODE=auto

# Use one URL-safe random password for PostgreSQL and encode it in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
DATABASE_URL=postgresql+psycopg://epm_automation:replace-with-a-long-url-safe-password@postgres:5432/epm_automation

# Use at least 32 random bytes. Keep the value stable across deployments.
WEB_SESSION_SECRET=replace-with-a-long-random-secret

# Select exactly one configured agent provider.
AGENT_PROVIDER=gemini
AGENT_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=replace-me
GROQ_API_KEY=

# Optional application defaults.
DEFAULT_DATA_INTEGRATION_NAME=
DEFAULT_PIPELINE_CODE=
DEFAULT_DATA_MAP_NAME=

# Optional email notifications.
EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_SMTP_HOST=
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
