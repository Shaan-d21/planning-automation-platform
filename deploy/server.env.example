# Direct Docker deployment settings. Copy this file to the repository root as
# .env.docker and never commit the populated file.

# Required Oracle connection. This stage release uses REST engines only.
EPM_BASE_URL=https://your-environment.epm.oraclecloud.com
EPM_INTEGRATION_USERNAME=service.account@example.com
EPM_INTEGRATION_PASSWORD=replace-me
APPLICATION_NAME=ExactPlanningApplicationName
EPM_DEPLOYMENT_MODE=auto

# Use a long URL-safe password. Compose uses it for PostgreSQL and constructs
# the internal DATABASE_URL automatically, preventing credential mismatches.
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password

# Use a different long random value and keep it stable across restarts.
WEB_SESSION_SECRET=replace-with-a-long-random-secret
WEB_SECURE_COOKIES=true

# Keep the application private to this computer. The optional tunnel container
# reaches the web service through Docker's internal network.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080

# Optional. Create a remotely managed Cloudflare Tunnel and paste its connector
# token here. Configure its published application service as http://web:8080.
CLOUDFLARE_TUNNEL_TOKEN=

# Configure one agent provider.
AGENT_PROVIDER=gemini
AGENT_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=replace-me
GROQ_API_KEY=

# Optional application defaults.
DEFAULT_DATA_INTEGRATION_NAME=
DEFAULT_PIPELINE_CODE=
DEFAULT_DATA_MAP_NAME=

# Optional email notifications.
EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_SMTP_HOST=
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
